# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/voice_agent_studio?schema=public"

# Groq API
GROQ_API_KEY="your-groq-api-key-here"
# config.ts silently falls back to "openai/gpt-oss-120b" for any llama-3.1/3.3 model name
# (deprecated on Groq), so this is left as the actual default rather than a value that
# would be silently overridden. Set to any other currently-supported Groq model to use it.
GROQ_MODEL="openai/gpt-oss-120b"

# CORS
FRONTEND_URL="http://localhost:3000"

# Vapi (P2 - optional, real browser-based calls via the Web SDK — no phone number,
# no Twilio, no webhook needed). The backend needs NO Vapi credential at all; it only
# builds the assistant JSON from the agent's own config. The actual call key
# (NEXT_PUBLIC_VAPI_PUBLIC_KEY) goes in frontend/.env.local instead.
# These just pick which of Vapi's providers to ask for — adjust to whatever's enabled/
# free on the connected Vapi account:
# VAPI_MODEL_PROVIDER="openai"
# VAPI_MODEL_NAME="gpt-4o-mini"
# VAPI_VOICE_PROVIDER="vapi"
# VAPI_VOICE_ID="Elliot"
# VAPI_VOICE_VERSION="2"          # vapi voice v2 generally sounds less robotic than v1
# VAPI_VOICE_LANGUAGE="auto"      # auto-switches TTS language to match what's being said
# VAPI_TRANSCRIBER_PROVIDER="deepgram"
# VAPI_TRANSCRIBER_MODEL="nova-3"
# VAPI_TRANSCRIBER_LANGUAGE="multi"  # live code-switch detection instead of one fixed language
